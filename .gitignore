# =========================================================
# СЕКРЕТЫ И ЛОКАЛЬНАЯ КОНФИГУРАЦИЯ
# =========================================================
.env
.env.*
!.env.example

.envrc
.direnv/

# Ключи, сертификаты и прочие секреты
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
private/
credentials*.json
*credentials*.json
token*.txt
*.secret
*.secrets
.pypirc
.npmrc

# =========================================================
# БАЗА ДАННЫХ И ПОЛЬЗОВАТЕЛЬСКИЕ ДАННЫЕ
# =========================================================
# Внутри data/ лежит только локальная БД, её нельзя публиковать.
data/*
!data/.gitkeep

*.db
*.db-*
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.duckdb

# Резервные копии
backup*/
backups/
*.backup
*.bak
*.dump
*.sql.gz

# =========================================================
# PYTHON
# =========================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# =========================================================
# КЭШИ, ТЕСТЫ, ЛИНТЕРЫ
# =========================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/

# =========================================================
# ЛОГИ И ВРЕМЕННЫЕ ФАЙЛЫ
# =========================================================
*.log
logs/
*.tmp
*.temp
tmp/
temp/

# =========================================================
# IDE, ОС, ЛОКАЛЬНЫЕ АРТЕФАКТЫ
# =========================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Сессии и локальные настройки
*.session
*.session-journal
.opencode/
*.local
